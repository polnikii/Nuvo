<Window x:Class="Nuvo.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:Nuvo"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        WindowStartupLocation="Manual" Background="Black" Cursor="Cross"
        FontFamily="{StaticResource UiFont}" FontSize="12">
    <Window.Resources>
        <Style x:Key="ToolBtn" TargetType="RadioButton">
            <Setter Property="Width" Value="32"/>
            <Setter Property="Height" Value="32"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Foreground" Value="#8E8E93"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="B" CornerRadius="8" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#1AFFFFFF"/>
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="B" Property="Background" Value="#2EFFFFFF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="Pill" TargetType="Border">
            <Setter Property="Background" Value="#F22C2C2E"/>
            <Setter Property="CornerRadius" Value="12"/>
            <Setter Property="Padding" Value="6"/>
            <Setter Property="Cursor" Value="Arrow"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.25"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Canvas x:Name="Root" Background="Transparent">
        <Image x:Name="Shot" Stretch="Fill"/>
        <Path x:Name="Dim" Fill="#8C000000" IsHitTestVisible="False"/>
        <Rectangle x:Name="SelBorder" Stroke="White" StrokeThickness="1" Visibility="Collapsed" IsHitTestVisible="False"/>
        <Border x:Name="SizeLabel" Background="#CC1C1C1E" CornerRadius="6" Padding="7,3" Visibility="Collapsed" IsHitTestVisible="False">
            <TextBlock x:Name="SizeText" Foreground="White"/>
        </Border>
        <local:AnnotationLayer x:Name="Layer" Visibility="Collapsed" Cursor="Cross"/>

        <Border x:Name="Flyout" Style="{StaticResource Pill}" Visibility="Collapsed">
            <StackPanel x:Name="FlyoutHost"/>
        </Border>

        <Border x:Name="ModeBar" Style="{StaticResource Pill}">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="AreaBtn" Style="{StaticResource ToolBtn}" GroupName="m" IsChecked="True" ToolTip="Область">
                    <Path Data="M3,3 L13,3 L13,13 L3,13 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeDashArray="1.6 1.4" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton x:Name="WindowBtn" Style="{StaticResource ToolBtn}" GroupName="m" ToolTip="Окно">
                    <Path Data="M2,3 L14,3 L14,13 L2,13 Z M2,6.5 L14,6.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton x:Name="DesktopBtn" Style="{StaticResource ToolBtn}" GroupName="m" ToolTip="Весь рабочий стол">
                    <Path Data="M2,3 L14,3 L14,10.5 L2,10.5 Z M6,13.5 L10,13.5 M8,10.5 L8,13.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
                </RadioButton>
            </StackPanel>
        </Border>

        <Border x:Name="Toolbar" Style="{StaticResource Pill}" Visibility="Collapsed">
            <StackPanel Orientation="Horizontal">
                <RadioButton x:Name="ArrowBtn" Style="{StaticResource ToolBtn}" GroupName="t" IsChecked="True">
                    <Path Data="M3,13 L13,3 M7,3 L13,3 L13,9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton x:Name="RectBtn" Style="{StaticResource ToolBtn}" GroupName="t">
                    <Path Data="M3,4 L13,4 L13,12 L3,12 Z" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeLineJoin="Round" Width="16" Height="16"/>
                </RadioButton>
                <RadioButton x:Name="LineBtn" Style="{StaticResource ToolBtn}" GroupName="t">
                    <Path Data="M3,13 L13,3" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" Width="16" Height="16"/>
                </RadioButton>
                <Rectangle Width="1" Height="16" Fill="#33FFFFFF" Margin="6,0"/>
                <Button x:Name="ColorBtn" Style="{StaticResource PlainBtn}">
                    <Ellipse x:Name="ColorDot" Width="16" Height="16" Stroke="#33FFFFFF"/>
                </Button>
                <Button x:Name="BgBtn" Style="{StaticResource PlainBtn}">
                    <Ellipse x:Name="BgDot" Width="16" Height="16" Stroke="#33FFFFFF"/>
                </Button>
                <Rectangle Width="1" Height="16" Fill="#33FFFFFF" Margin="6,0"/>
                <Button x:Name="SaveBtn" Style="{StaticResource PlainBtn}" ToolTip="Сохранить (Ctrl+S)">
                    <Path Data="M8,2.5 L8,10 M4.8,7 L8,10.2 L11.2,7 M3,13.2 L13,13.2" Stroke="#D1D1D6"
                          StrokeThickness="1.6" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Width="16" Height="16"/>
                </Button>
            </StackPanel>
        </Border>
    </Canvas>
</Window>
